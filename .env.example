# =============================================================================
# CAREPATH — ENVIRONMENT VARIABLES & CONFIGURATION TEMPLATE
# =============================================================================
# All secrets and external API keys must be kept secure.
# For local demo and judge evaluation, CarePath runs in zero-config offline mode
# with built-in persistent transactional storage and simulated grounded AI.
# =============================================================================

# Application Environment ('development' | 'production' | 'test')
VITE_APP_ENV=development

# Optional: Firebase Cloud Firestore Configuration (If connecting to live project)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=carepath-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=carepath-demo
VITE_FIREBASE_STORAGE_BUCKET=carepath-demo.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: Google Gemini API (For live external LLM proxying; fallback engine active by default)
GEMINI_API_KEY=your_gemini_api_key_here
